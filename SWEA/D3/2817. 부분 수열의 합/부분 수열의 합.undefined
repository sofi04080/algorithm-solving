
import java.util.Scanner;
import java.io.FileInputStream;

class Solution
{
    static int count;
    static int[] nums;
    static int N;
    static int K;
	public static void main(String args[]) throws Exception
	{

		Scanner sc = new Scanner(System.in);
		int T;
		T=sc.nextInt();

		for(int test_case = 1; test_case <= T; test_case++)
		{
            N = sc.nextInt();
            K = sc.nextInt();
            nums = new int[N];

            for(int i = 0; i < N; i++)
                nums[i] = sc.nextInt();
			
            count(0, new boolean[N]);

            System.out.println("#" + test_case + " " + count);
            count = 0;			
		}
	}
    
        static void count(int idx, boolean[] exist) {
        int sum = 0;
        if(idx == N) {
            for(int i = 0; i < N; i++){
                if(exist[i])
                    sum += nums[i];
            }
            if(sum == K)
                count++;
            return;
        }
        exist[idx] = true;
        count(idx + 1, exist);
        exist[idx] = false;
        count(idx + 1, exist);
    }
}