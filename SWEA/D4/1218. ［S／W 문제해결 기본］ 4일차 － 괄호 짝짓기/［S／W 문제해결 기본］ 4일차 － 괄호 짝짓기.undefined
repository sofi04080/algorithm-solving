
import java.util.*;
import java.io.FileInputStream;

class Solution
{
	public static void main(String args[]) throws Exception
	{
		Scanner sc = new Scanner(System.in);

		for(int test_case = 1; test_case <= 10; test_case++)
		{
            int length = sc.nextInt();
            String str = sc.next();
            char[] chars = str.toCharArray();
            System.out.println("#" + test_case + " " + isValid(length, chars));
        }
	}
    
    static int isValid(int length, char[] chars) {
            Stack<Character> stack = new Stack<>();
            for(int i = 0; i < length; i++) {
                if(chars[i] == '{' || chars[i] == '[' || chars[i] == '(' ||
                        chars[i] == '<' )
                    stack.push(chars[i]);
                else
                    if(stack.isEmpty()) {
                        return 0;
                    } else {
                        switch(chars[i]){
                            case('}'):
                                if(stack.peek() == '{'){
                                    stack.pop();
                                } else {
                                    return 0;
                                }
                                break;
                            case(']'):
                                if(stack.peek() == '['){
                                    stack.pop();
                                } else {
                                    return 0;
                                }
                                break;
                            case(')'):
                                if(stack.peek() == '('){
                                    stack.pop();
                                } else {
                                    return 0;
                                }
                                break;
                            case('>'):
                                if(stack.peek() == '<'){
                                    stack.pop();
                                } else {
                                    return 0;
                                }
                                break;
                        }
                    }
                }
                if(stack.isEmpty()){
                    return 1;
                }
                return 0;
    	}
}