
import java.util.*;
import java.io.FileInputStream;

class Solution
{
    static int[] dr = {-1, 1, 0, 0};
    static int[] dc = {0, 0, -1, 1};
    
	public static void main(String args[]) throws Exception
	{

		Scanner sc = new Scanner(System.in);
		int T;
		T=sc.nextInt();

		for(int test_case = 1; test_case <= T; test_case++)
		{
            int N = sc.nextInt();
            int[][] map = new int[N][N];
            int[][] dist = new int[N][N];
            boolean[][] visited = new boolean[N][N];

            for(int i = 0; i < N; i++) {
                String next = sc.next();
                for(int j = 0; j < N; j++) {
                    map[i][j] = next.toCharArray()[j] - '0';
                    visited[i][j] = false;
                    dist[i][j] = Integer.MAX_VALUE;
                }
            }

            PriorityQueue<Node> pq = new PriorityQueue<>();

            // 배열의 값 자체를 간선 비용으로 처리
            pq.add(new Node(0, 0, map[0][0]));
            dist[0][0] = map[0][0];

            int ans =0;
            while(!pq.isEmpty()) {
                Node n = pq.poll();

                // 목적지에 도달했으므로 탈출
                if(n.r == N - 1 && n.c == N -1) {
                    ans = n.cost;
                    break;
                }
                // 이미 방문한 노드는 패스
                if(visited[n.r][n.c]) continue;

                visited[n.r][n.c] = true;

                for(int j = 0; j < 4; j++) {
                    int nextR = n.r + dr[j];
                    int nextC = n.c + dc[j];

                    if(nextR < N && nextR >= 0 && nextC < N && nextC >=0 && !visited[nextR][nextC]) {
                        int totalCost = n.cost + map[nextR][nextC];

                        if(totalCost < dist[nextR][nextC]) {
                            dist[nextR][nextC] = totalCost;
                            pq.add(new Node(nextR, nextC, totalCost));
                        }
                    }
                }
            }

            System.out.println("#" + test_case + " " + ans);			
		}
	}
        static class Node implements Comparable<Node> {
        int r, c, cost;

        public Node(int r, int c, int cost) {
            this.r = r;
            this.c = c;
            this.cost = cost;
        }

        @Override
        public int compareTo(Node o) {
            return this.cost - o.cost;
        }
    }
}