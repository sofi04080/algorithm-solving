
import java.util.Scanner;
import java.io.FileInputStream;

class Solution
{
    static int N, X, M, MAX;
    static data[] observed;
    static int[] cage;
    static int[] ans;
    
	public static void main(String args[]) throws Exception
	{

		Scanner sc = new Scanner(System.in);
		int T;
		T=sc.nextInt();

		for(int test_case = 1; test_case <= T; test_case++)
		{
            // 우리 개수, 우리 당 최대 마릿수, 관칠 기록 수
            N = sc.nextInt();
            X = sc.nextInt();
            M = sc.nextInt();

            // 관찰기록
            observed = new data[M];
            for(int i = 0; i < M; i++) {
                observed[i] = new data(sc.nextInt(), sc.nextInt(), sc.nextInt());
            }

            // 완전탐색, 1번 우리부터
            cage = new int[N+1]; // 인덱스 일치시키자
            ans = new int[N+1];
            MAX = Integer.MIN_VALUE;
            dfs(1);

            System.out.print("#" + test_case + " ");
            if(isAns()){
            	for(int i = 1; i <= N; i++) System.out.print(ans[i] + " ");
            } else System.out.print(-1 + " ");
            System.out.println();
		}
	}
    
    static void dfs(int idx) {
        if(idx == N + 1) {
            if(check()) {
                int sum = 0;
                for(int i : cage) sum += i;
                if(MAX < sum) {
                    MAX = sum;
                    for (int i = 1; i < N + 1; i++) {
                        ans[i] = cage[i];
                    }
                }
            }
            return;
        }

        for(int i = 0; i <= X; i++) {
            cage[idx] = i;
            dfs(idx + 1);
        }
    }

    // 조건 일치 체킹 메서드
    static boolean check() {
        // 모든 기록 데이터에 관해서
        for(data data: observed) {
            int start = data.start;
            int end = data.end;
            int number = data.number;
            int sum = 0;

            for(int i = start; i <= end; i++) {
                sum += cage[i];
            }
            // 합계가 측정된 데이터와 다르다면 가짜 데이터
            if(sum != number)
                return false;
        }
        return true;
    }

    static class data {
        int start, end, number;
        public data(int start, int end, int number) {
            this.start = start;
            this.end = end;
            this.number = number;
        }
    }
    
    // 정답 배열 존재 유무
    static boolean isAns() {
		return MAX != Integer.MIN_VALUE;
    }    
}