import java.util.*;

public class Solution {
	static int N, M, R, C, L, ans;
	static int[][] map;
	static boolean[][] visited; // 방문 처리용
	// 우 하 좌 상 순서
	static int[] dr = {0, 1, 0, -1};
	static int[] dc = {1, 0 , -1, 0};
	// 터널 종류 -> 모든 테스트 케이스에서 공용 사용 
	static int[][] tunnel = {
			{}, // 0번 인덱스는 공백으로 사용하지 않음
			{0, 1, 2, 3}, 	// 십자 모양 터널
			{1, 3}, 		// 하, 상 연결
			{0, 2},			// 좌, 우 연결
			{0, 3},			// 우, 상
			{0, 1},			// 우, 하
			{1, 2},			// 하, 좌
			{2, 3}			// 상, 좌
	};
	
	static class Person {
		int r, c, time;

		public Person(int r, int c, int time) {
			super();
			this.r = r;
			this.c = c;
			this.time = time;
		}
	}
	
	public static void main(String[] args) {
		Scanner  sc = new Scanner(System.in);
		int T = sc.nextInt();
		for(int tc = 1; tc <= T; tc++) {
			N = sc.nextInt(); // 행 크기
			M = sc.nextInt(); // 열 크기
			R = sc.nextInt(); // 맨홀 행 좌표
			C = sc.nextInt(); // 맨홀 열 좌표
			L = sc.nextInt(); // 시간 1 ~ 20
			
			map = new int[N][M];
			visited = new boolean[N][M];
			
			for(int i = 0; i < N; i++) {
				for(int j= 0; j <M; j++) {
					map[i][j] = sc.nextInt();
				}
			}
			
			ans = 1;
			
			bfs();
			
			System.out.println("#" + tc + " " + ans);
		}
	}
	
	static void bfs() {
		Queue<Person> q = new ArrayDeque<>();
		q.add(new Person(R, C, 1));
		visited[R][C] = true;
		
		while(!q.isEmpty()) {
			Person p = q.poll();
			
			if(p.time == L) {
				continue;
			}
			
			// 터널 타입
			int type = map[p.r][p.c]; //현재 터널 타입
			for(int d : tunnel[type]) { // 현재 터널에서 갈 수 있는 방향
				int nr = p.r + dr[d];
				int nc = p.c + dc[d];
				
				// 범위와 방문 체크
				if(nr < 0 || nc < 0 || nr >= N || nc >= M || visited[nr][nc]) 
					continue;
				// 터널 체크
				if(map[nr][nc] == 0)
					continue;
				
				// 다음 좌표의 터널 모양
				int nextType = map[nr][nc];
				int d2 = (d + 2) % 4; // 반대 방향 알아내기
				
				// 다음 터널과 현재 터널이 이어져 있는 방향을 알고 있다
				if(!canMove(nextType, d2)) continue;
				
				q.add(new Person(nr, nc, p.time+1));
				visited[nr][nc] = true;
				ans++;
			}
		}
	}
	
	static boolean canMove(int type, int dir) {
		for(int d : tunnel[type]) {
			if(d == dir) return true;
		}
		return false;
	}
}