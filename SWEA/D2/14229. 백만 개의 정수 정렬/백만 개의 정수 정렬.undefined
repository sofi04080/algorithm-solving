
import java.util.Scanner;
import java.io.FileInputStream;

class Solution
{
    static int[] A;
	public static void main(String args[]) throws Exception
	{
		Scanner sc = new Scanner(System.in);
        A = new int[1000000];
		for(int i = 0; i < 1000000; i++)
            A[i] = sc.nextInt();
        
        quickSort(0, A.length - 1);
        
        System.out.println(A[500000]);
	}
    
    static void quickSort(int L, int R) {
    	if(L < R) {
            int pivot = lomuto(L, R);
            quickSort(L, pivot - 1);
            quickSort(pivot + 1, R);
        }
    }
    
    static int lomuto(int L, int R) {
    	int i = L - 1;
        int pivot = A[R];
        for(int j = L; j < R;j++){
            if(A[j] <= pivot) {
                i++;
                int tmp = A[j];
                A[j] = A[i];
                A[i] = tmp;
            }
        }
        int tmp = A[R];
        A[R] = A[i+1];
        A[i+1] = tmp;
        
        return i+1;
    }
}